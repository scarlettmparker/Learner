scalar JSON

type PagedAccounts {
  items: [Account!]!
  pageInfo: PageInfo!
}

type Account {
  id: String!
  username: String!
  personId: ID!
  status: AccountStatus!
  provider: String
  remoteUsers: [RemoteUser!]
  createdAt: DateTime
  updatedAt: DateTime
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING
  DEACTIVATED
}

type Role {
  id: ID!
  name: String!
  description: String
  createdAt: DateTime
  updatedAt: DateTime
}

type GaiaQueries {
  me: Account
  propertySet(ownerKey: String!, name: String!, entry: String): JSON
  myRoles: [String!]!
  account(id: ID!): Account
  accounts(pagination: PaginationInput): PagedAccounts!
  roles: [Role!]!
  role(id: ID!): Role
  accountRoles(accountId: ID!): [String!]!
  accountPermissions(accountId: ID!): [String!]!
  rolePermissions(roleId: ID!): [String!]!
  allPermissions: [String!]!
}

input LoginInput {
  username: String!
  password: String!
}

type AuthResult {
  token: String!
  accountId: ID!
  personId: ID!
}

type LogoutResponse {
  message: String!
}

type SuspendAccountResponse {
  message: String!
  account: Account!
}

type UnsuspendAccountResponse {
  message: String!
  account: Account!
}

type CreateRoleResponse {
  message: String!
  role: Role!
}

type DeleteRoleResponse {
  message: String!
  id: ID!
}

type SetAccountRolesResponse {
  message: String!
  accountId: ID!
  roles: [String!]!
}

type SetAccountPermissionsResponse {
  message: String!
  accountId: ID!
  permissions: [String!]!
}

type SetRolePermissionsResponse {
  message: String!
  roleId: ID!
  permissions: [String!]!
}

type DeactivateAccountResponse {
  message: String!
}

type RequestAccountReactivationResponse {
  message: String!
}

type ConfirmAccountReactivationResponse {
  message: String!
}

type GaiaMutations {
  login(input: LoginInput!): AuthResult
  logout: LogoutResponse!
  suspendAccount(id: ID!): SuspendAccountResponse!
  unsuspendAccount(id: ID!): UnsuspendAccountResponse!
  createRole(name: String!, description: String): CreateRoleResponse!
  deleteRole(id: ID!): DeleteRoleResponse!
  setAccountRoles(accountId: ID!, roleNames: [String!]!): SetAccountRolesResponse!
  setAccountPermissions(accountId: ID!, permissions: [String!]!): SetAccountPermissionsResponse!
  setRolePermissions(roleId: ID!, permissions: [String!]!): SetRolePermissionsResponse!
  deactivateAccount: DeactivateAccountResponse!
  requestAccountReactivation(email: String!, provider: String!): RequestAccountReactivationResponse!
  confirmAccountReactivation(token: String!): ConfirmAccountReactivationResponse!
}

extend type Query {
  gaiaQueries: GaiaQueries!
}

extend type Mutation {
  gaiaMutations: GaiaMutations!
}
